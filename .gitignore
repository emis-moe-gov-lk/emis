# Environment - Sensitive configuration files containing secrets and credentials
.env
*.env

# Node.js - Dependencies, build artifacts, and generated config
node_modules/
dist/
web/.flowbite-react/

# PHP / Laravel - Framework auto-generated files and cache
vendor/
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
*/storage/framework/views/*
!storage/framework/views/
bootstrap/cache/*
.phpunit.result.cache

# Temporary - User workspace and runtime artifacts
tmp/

# IDE & Editors - Editor-specific config and temporary swap files
.idea/
.vscode/
.playwright-mcp/
*.swp
*.swo
*~

# AI Assistant Tools - Temporary cache, session files, and generated config
# from AI coding assistants (aider, Claude Code, Gemini CLI, etc.)
.claude
.gemini/
.antigravity/
.codex/
.aider*
.cursor/
.copilot/
.windsurf/

# Operating System - System-generated metadata files
.DS_Store
Thumbs.db

# Docker - Local overrides and generated certificates
docker-compose.override.yml
infrastructure/docker-swarm/nginx-proxy/certs/*.pem
apim/certs/*.pem
is/certs/*.pem

# Ansible - Sensitive variables, secrets, and generated artifacts
vars.yml
hosts.yml
.vault_pass
infrastructure/ansible/deploy-noapim/env/*.yml
!infrastructure/ansible/deploy-noapim/env/*.example
infrastructure/ansible/deploy-noapim/inventory/*.yml
!infrastructure/ansible/deploy-noapim/inventory/*.example
.facts_cache/
*actual*.yml
*.retry

# Backup Files - Editor and system backup artifacts
*.bck
serviceminutes
