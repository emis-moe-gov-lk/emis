{
    # Enable FrankenPHP
    frankenphp
}

# Listen strictly on HTTP port 80. 
# We specify http:// so it knows NOT to try and generate an SSL cert for this domain.
http://api-uat.domain.com, :80 {
    # Set this to the directory where your main index.php lives
    root * /app/public 
    
    # Execute PHP files
    php_server
}
