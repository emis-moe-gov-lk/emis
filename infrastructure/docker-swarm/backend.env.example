APP_NAME=EMIS-HRM
APP_ENV=local
APP_KEY=
APP_DEBUG=True
APP_URL=api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=emis
DB_USERNAME=emis-user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

VITE_APP_NAME=EMIS-HRM

# JWT verification — JwtGuard fetches {WSO2_BASE_URL}/oauth2/jwks
WSO2_ENABLED=True
WSO2_BASE_URL=https://idp.app-uat.emis.moe.gov.lk
WSO2_VERIFY_SSL=False

# SCIM2 provisioning (Wso2IsProvisioningService) — used at seed time and by
# account-provisioning flows to create/link users in IS and capture
# identity_provider_user_id. Same CEMIS-LK M2M app as the ASGARDEO_* pair.
WSO2_M2M_CLIENT_ID=__SET_BY_configure-auth.sh__
WSO2_M2M_CLIENT_SECRET=__SET_BY_configure-auth.sh__

# IS role UUIDs (scim2/v2/Roles) for role assignment during provisioning.
# Harvest from IS after configure-is-and-apim.yml creates the roles; leave
# empty to skip role assignment (logged as a warning, not an error).
WSO2_ROLE_ID_TEACHER=
WSO2_ROLE_ID_PRINCIPAL=
WSO2_ROLE_ID_ZONAL_DEO=
WSO2_ROLE_ID_ZONAL_DEO_HEAD=
WSO2_ROLE_ID_ZONAL_DIRECTOR=
WSO2_ROLE_ID_ZONAL_DEPUTY_DIRECTOR=
WSO2_ROLE_ID_DIVISIONAL_DEO=
WSO2_ROLE_ID_DIVISIONAL_HEAD=
WSO2_ROLE_ID_DEVELOPMENT_OFFICER=
WSO2_ROLE_ID_DEVELOPMENT_OFFICER_HEAD=
WSO2_ROLE_ID_PROVINCIAL_DIRECTOR=
WSO2_ROLE_ID_PROVINCIAL_DEPUTY_DIRECTOR=
WSO2_ROLE_ID_PROVINCIAL_SUBJECT_HEAD=
WSO2_ROLE_ID_PROVINCIAL_CLERK_DEO=
WSO2_ROLE_ID_VICE_PRINCIPAL=
WSO2_ROLE_ID_SCHOOL_DEO=
WSO2_ROLE_ID_MOE_ADMINISTRATOR=
WSO2_ROLE_ID_PSC_OFFICER=
WSO2_ROLE_ID_SSA=
WSO2_ROLE_ID_SUPER_ADMIN=

# SCIM2 user provisioning — values filled by scripts/configure-auth.sh after
# the configure-is-and-apim playbook provisions the CEMIS-LK M2M application.
ASGARDEO_SCIM_BASE_URL=https://idp.app-uat.emis.moe.gov.lk/scim2
ASGARDEO_MGMT_TOKEN_URL=https://idp.app-uat.emis.moe.gov.lk/oauth2/token
ASGARDEO_CLIENT_ID=__SET_BY_configure-auth.sh__
ASGARDEO_CLIENT_SECRET=__SET_BY_configure-auth.sh__
ASGARDEO_SCOPES=internal_user_mgt_create internal_user_mgt_update internal_user_mgt_view
