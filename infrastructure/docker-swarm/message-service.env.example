# Server
PORT=3001
NODE_ENV=production
SKIP_MIGRATIONS=false

# CORS — exact frontend origin, no trailing slash
CORS_ORIGIN=https://app-uat.emis.moe.gov.lk

# APIM upstream
APIM_BASE_URL=https://services.app-uat.emis.moe.gov.lk/hrm/1.0.0

# WSO2 Identity Server — JWT validation
WSO2_JWKS_URI=https://idp.app-uat.emis.moe.gov.lk/oauth2/jwks
WSO2_ISSUER=https://idp.app-uat.emis.moe.gov.lk/oauth2/token
WSO2_AUDIENCE=
JWKS_CACHE_TTL=3600

# MySQL
DB_HOST=
DB_PORT=3306
DB_NAME=emis
DB_USER=
DB_PASSWORD=

# MySQL — migration user (optional, falls back to DB_USER if not set)
DB_MIGRATE_USER=
DB_MIGRATE_PASSWORD=

# Laravel service-to-service secret — must match MESSAGE_SERVICE_SECRET in backend.env
LARAVEL_BASE_URL=http://backend
LARAVEL_SERVICE_SECRET=
