# Local default points at the bundled WSO2 IS reached through nginx-proxy.
# For prod swarm, override to the public IdP URL via ansible vars.yml.
VITE_ASGARDEO_BASE_URL=https://idp.app-uat.emis.moe.gov.lk
# Set by scripts/configure-auth.sh after the configure-is-and-apim playbook
# generates the EMIS Web App's OAuth client in IS.
VITE_ASGARDEO_CLIENT_ID=__SET_BY_configure-auth.sh__
VITE_SIGNIN_REDIRECT_URL=https://app-uat.emis.moe.gov.lk/authentication/callback
VITE_SIGNOUT_REDIRECT_URL=https://app-uat.emis.moe.gov.lk/logout

VITE_API_BASE_URL=https://services.app-uat.emis.moe.gov.lk/hrm/1.0.0
