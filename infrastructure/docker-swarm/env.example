# ── Stack identity ───────────────────────────────────────────
STACK_NAME=emis-local
STACK_NETWORK_SUBNET=172.22.0.0/16

# ── Host port mappings ───────────────────────────────────────
FRONTEND_HOST_PORT=80
BACKEND_HOST_PORT=9000
IS_HOST_PORT=9444
APIM_HOST_PORT=9443
APIM_GATEWAY_PORT=8243
APIM_GATEWAY_HTTP_PORT=8280

# ── MySQL container ──────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=emis_hrm_db_local
MYSQL_USER=emis-user-local
MYSQL_PASSWORD=changeme

# ── Docker image tags ────────────────────────────────────────
FRONTEND_DOCKERIMG_REPO=emis-frontend
FRONTEND_DOCKERIMG_TAG=local

BACKEND_DOCKERIMG_REPO=emis-backend
BACKEND_DOCKERIMG_TAG=local

WSO2_IS_DOCKERIMG_REPO=emis-is
WSO2_IS_DOCKERIMG_TAG=local

WSO2_APIM_DOCKERIMG_REPO=emis-apim
WSO2_APIM_DOCKERIMG_TAG=local
