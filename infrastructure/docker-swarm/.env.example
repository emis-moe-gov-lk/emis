# Image repo/tag values used by docker-stack.yml.
# For local-dev compose builds, leave these as the emis-* placeholders below.
# For prod swarm deploys, ansible renders the real registry values into this file.

WSO2_IS_DOCKERIMG_REPO=emis-is
WSO2_IS_DOCKERIMG_TAG=local

WSO2_APIM_DOCKERIMG_REPO=emis-apim
WSO2_APIM_DOCKERIMG_TAG=local

FRONTEND_DOCKERIMG_REPO=emis-frontend
FRONTEND_DOCKERIMG_TAG=local

BACKEND_DOCKERIMG_REPO=emis-backend
BACKEND_DOCKERIMG_TAG=local
