---
# ============================================================
# EMIS Deployment Environment — EXAMPLE
# ============================================================
# Use this file as a template for new environments.
# Copy to <env>.yml, and fill in the required [REQUIRED] values.
# Credentials marked [VAULT] should be encrypted:
#   ansible-vault encrypt_string 'value' --name 'key'
# ============================================================

# -- Stack identity --
stack_name: emis-example
deploy_env: example
expected_public_ip: "127.0.0.1"                           # [REQUIRED] Update to actual reverse proxy IP
stack_deploy_path: /opt/emis-example
stack_network_subnet: "172.x.0.0/16"

# Base Endpoints (Centralized)
frontend_url: "https://app.example.com"
backend_url:  "https://api.example.com"
idp_hostname: "idp.example.com"
apim_hostname: "apim.example.com"                         # APIM only — omit for no-APIM envs

# -- Host Port Mappings --
frontend_host_port: 80
backend_host_port:  9000
is_host_port:       9444
apim_host_port:     9443                                  # APIM only
apim_gateway_port:  8243                                  # APIM only
apim_gateway_http_port: 8280                              # APIM only

# -- Docker image tags --
frontend_image_repo: ghcr.io/your-org/emis-frontend       # [REQUIRED]
frontend_image_tag:  "1.0.0"                               # [REQUIRED]
backend_image_repo:  ghcr.io/your-org/emis-backend        # [REQUIRED]
backend_image_tag:   "1.0.0"                               # [REQUIRED]
is_image_repo:       ghcr.io/your-org/emis-is             # [REQUIRED]
is_image_tag:        "1.0.0"                               # [REQUIRED]
apim_image_repo:     ghcr.io/your-org/emis-apim           # [REQUIRED] APIM only
apim_image_tag:      "1.0.0"                               # [REQUIRED] APIM only

# -- Docker registry auth --
registry_host:     ghcr.io
registry_username: your-org                                # [REQUIRED]
registry_password: changeme                                # [REQUIRED] [VAULT]

# -- MySQL — EMIS database --
mysql_root_password: changeme                              # [REQUIRED] [VAULT]
mysql_emis_db:       emis_db_name
mysql_emis_user:     emis_db_user
mysql_emis_password: changeme                              # [REQUIRED] [VAULT]
mysql_bind_address:  0.0.0.0

# -- MySQL — WSO2 databases --
mysql_wso2_user:          wso2_db_user
mysql_wso2_password:      changeme                         # [REQUIRED] [VAULT]
mysql_is_db:              wso2_is_db
mysql_is_shared_db:       wso2_is_shared_db
mysql_apim_db:            wso2_apim_db                     # APIM only

# -- WSO2 IS --
is_hostname:          "{{ idp_hostname }}"
is_proxy_host:        "{{ idp_hostname }}"
is_proxy_port:        "443"
is_admin_user:        admin
is_admin_password:    changeme                             # [REQUIRED] [VAULT]
is_db_host:           "{{ hostvars[groups['db_host'][0]].ansible_host }}"
is_db_port:           "3306"

# -- Backend (Laravel) --
app_name:    EMIS
app_env:     production
app_key:     base64:example_key==                          # [REQUIRED] [VAULT]
app_debug:   "false"
app_url:     "{{ backend_url }}"

db_host:     "{{ hostvars[groups['db_host'][0]].ansible_host }}"
db_port:     "3306"
db_database: "{{ mysql_emis_db }}"
db_username: "{{ mysql_emis_user }}"
db_password: "{{ mysql_emis_password }}"

wso2_enabled:    "True"
wso2_base_url:   "https://{{ is_hostname }}"
wso2_verify_ssl: "False"
# Populated after configure-is-only.yml runs:
wso2_m2m_client_id:     ""
wso2_m2m_client_secret: ""
wso2_teacher_role_id:   ""

memcached_host: memcached

# -- WSO2 APIM --
apim_notification_host: "wso2-apim"                        # Docker service name (internal)
apim_notification_port: "9443"
apim_notification_user: admin
apim_notification_password: changeme                       # [VAULT] Must match Infisical APIM_ADMIN_PASSWORD

# -- Infisical — APIM config injection --
infisical_apim_client_id:     changeme                     # [REQUIRED] [VAULT]
infisical_apim_client_secret: changeme                     # [REQUIRED] [VAULT]
infisical_apim_project_id:    changeme                     # [REQUIRED]
infisical_apim_env:           dev                          # [REQUIRED]

# -- Frontend (Vite — baked at image build time) --
vite_asgardeo_base_url:  "https://{{ is_hostname }}"
vite_asgardeo_client_id: ""
vite_signin_redirect_url:  "{{ frontend_url }}/authentication/callback"
vite_signout_redirect_url: "{{ frontend_url }}/logout"
# Direct backend URL — no APIM gateway in this topology
vite_api_base_url:         "{{ backend_url }}/api"

# -- EMIS application resources (used by configure-is-only) --
emis_roles:
  - "RoleName"

# emis_users:
#   - username:    sampleuser
#     password:    SamplePassword123!                       # [VAULT]
#     first_name:  Sample
#     last_name:   User
#     email:       sampleuser@example.com
#     roles:       [RoleName]

# OIDC apps created directly in IS (no APIM devportal).
# Each entry is processed by configure-is-only.yml.
# Add/remove/edit entries here — no playbook changes needed.
emis_apps:
  - name: "EMIS Web App"
    description: "EMIS Frontend SPA"
    template_id: ""                                          # standard OIDC — no template
    public_client: true
    grant_types:
      - "authorization_code"
      - "refresh_token"
    callback_urls:
      - "{{ frontend_url }}/authentication/callback"
      - "{{ frontend_url }}/logout"
      - "https://localhost:5173/authentication/callback"
      - "https://localhost:5173/logout"
    allowed_origins:
      - "{{ frontend_url }}"
      - "https://localhost:5173"
    claims:
      dialect: "LOCAL"
      requested_claims:
        - claim:
            uri: "http://wso2.org/claims/emailaddress"
          mandatory: false
        - claim:
            uri: "http://wso2.org/claims/roles"
          mandatory: false
      subject:
        uri: "http://wso2.org/claims/userid"
        include_user_domain: false
        include_tenant_domain: false
        use_mapped_local_subject: false
    associated_roles:
      allowed_audience: "ORGANIZATION"
    oidc_custom_config:
      pkce:
        mandatory: false
        support_plain: false
      access_token:
        type: "JWT"
        user_expiry: 3600
        app_expiry: 3600
        attributes:
          - "email"
          - "given_name"
          - "roles"
      refresh_token:
        expiry: 86400
      id_token:
        expiry: 3600

  - name: "EMIS-HRM M2M"
    description: "Machine-to-Machine application for SCIM2 API access"
    template_id: "m2m-application"
    public_client: false
    grant_types:
      - "client_credentials"
    callback_urls: []
    allowed_origins: []
    authorized_apis:
      - identifier: "/scim2/Users"
        policy: "RBAC"
        scopes:
          - "internal_user_mgt_create"
          - "internal_user_mgt_update"
      - identifier: "/scim2/Roles"
        policy: "RBAC"
        scopes:
          - "internal_role_mgt_update"
          - "internal_role_mgt_users_update"
