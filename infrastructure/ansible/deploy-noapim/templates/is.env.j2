IS_HOSTNAME={{ is_hostname }}
IS_PROXY_HOST={{ is_proxy_host }}
IS_PROXY_PORT={{ is_proxy_port }}
IS_ADMIN_NAME={{ is_admin_user }}
IS_ADMIN_PASSWORD={{ is_admin_password }}
IS_DB_HOST={{ is_db_host }}
IS_DB_PORT={{ is_db_port }}
IS_DB_IDENTITY={{ mysql_is_db }}
IS_DB_SHARED={{ mysql_is_shared_db }}
IS_DB_WSO2USER_USERNAME={{ mysql_wso2_user }}
IS_DB_WSO2USER_PASSWORD={{ mysql_wso2_password }}
# The IS image's deployment.toml contains an APIM token-revocation event_listener
# that requires these env vars at startup. There is no APIM in this topology so
# notifications will fail silently — this has no functional impact.
APIM_HOST=localhost
APIM_PORT=9443
APIM_WSO2USER_USERNAME=admin
APIM_WSO2USER_PASSWORD=admin
