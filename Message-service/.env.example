# Server
PORT=3001
NODE_ENV=development
SKIP_MIGRATIONS=false

# APIM upstream (Phase 1 sync)
APIM_BASE_URL=https://services.app-uat.emis.moe.gov.lk/hrm/1.0.0

# CORS — exact frontend origin, no trailing slash
CORS_ORIGIN=https://app-uat.emis.moe.gov.lk

# WSO2 Identity Server — JWT validation
WSO2_JWKS_URI=https://api.asgardeo.io/t/<org>/oauth2/jwks
WSO2_ISSUER=https://api.asgardeo.io/t/<org>/oauth2/token
WSO2_AUDIENCE=
JWKS_CACHE_TTL=3600

# MySQL — runtime user (SELECT, INSERT, UPDATE only)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=emis_alerts
DB_USER=alert_service
DB_PASSWORD=

# MySQL — migration user (optional, falls back to DB_USER if not set)
DB_MIGRATE_USER=
DB_MIGRATE_PASSWORD=
